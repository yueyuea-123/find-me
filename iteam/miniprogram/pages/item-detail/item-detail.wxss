/* pages/item-detail/item-detail.wxss */
/* 头部：对齐 demo pItemDetail 的 52px 图标块 + serif 19px 名称 */
.hero-icon { width: 104rpx; height: 104rpx; font-size: 48rpx; border-radius: 26rpx; }
.hero-name { font-family: "Songti SC", "STSong", serif; font-size: 38rpx; font-weight: 600; color: #252824; }
.kv { display: flex; justify-content: space-between; align-items: flex-start; padding: 14rpx 0; font-size: 27rpx; border-bottom: 1rpx solid #ECE9E3; }
.thumb { width: 120rpx; height: 120rpx; border-radius: 20rpx; }
.chips4 { display: flex; flex-wrap: wrap; margin: 12rpx 0 6rpx; }
.chips4 .tag { margin-right: 12rpx; }
/* P1-5 标签 */
.mini-tag { font-size: 20rpx; color: #6F8966; background: #F0EFEB; border-radius: 999rpx; padding: 4rpx 14rpx; margin: 0 10rpx 8rpx 0; }
/* 收藏星标（交互说明书 V1.2 §5） */
.fav-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; flex-shrink: 0; }
.fav-star { font-size: 48rpx; line-height: 1; color: #B4B2A9; padding: 4rpx 8rpx; }
.fav-star.on { color: #D89A3D; }
