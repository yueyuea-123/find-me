<view class="page" wx:if="{{item}}">
  <!-- 头部：对齐 demo pItemDetail 的图标块 + serif 名称 + 档案进度 -->
  <view class="card hero-item">
    <view class="row">
      <view class="icon-box hero-icon">▣</view>
      <view class="grow" style="margin-left:24rpx">
        <view class="hero-name">{{item.name}}</view>
        <view class="card-s">{{item.catText}} · {{item.modeText}}</view>
        <view class="row" style="flex-wrap:wrap;margin-top:10rpx" wx:if="{{item.tags.length}}">
          <text class="mini-tag" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
        </view>
      </view>
      <view class="fav-wrap">
        <text class="fav-star {{item.favorite?'on':''}}" bindtap="toggleFavorite">{{item.favorite?'★':'☆'}}</text>
        <text class="tag {{item.mgmtClass}}">{{item.mgmtText}}</text>
      </view>
    </view>
    <view class="row between small" style="margin-top:20rpx">
      <text class="muted">档案完善度</text><text>档案 {{item.completed}}%</text>
    </view>
    <view class="bar"><view style="width:{{item.completed}}%"></view></view>
  </view>

  <view class="card" wx:if="{{justCreated}}">
    <view class="card-t">档案已建立</view>
    <view class="small muted">下一步：{{nextHint}}</view>
    <button class="btn sm primary" style="margin-top:16rpx" bindtap="goNext">{{nextBtn}}</button>
  </view>

  <view class="card">
    <view class="card-t">当前状态</view>
    <view class="small muted" style="margin-top:6rpx">最近确认：{{item.updatedText}}</view>
    <view class="chips4">
      <text class="tag {{item.locationKey==='at_home'?'green':'gray'}}">在家</text>
      <text class="tag {{item.locationKey==='unknown'?'orange':'gray'}}">位置未知</text>
      <text class="tag {{item.locationKey==='out'?'orange':'gray'}}">外出携带</text>
      <text class="tag {{item.locationKey==='borrowed'?'orange':'gray'}}">借出</text>
    </view>
    <view class="kv"><text class="muted">位置状态</text><text class="tag {{item.locClass}}">{{item.locText}}</text></view>
    <view class="kv"><text class="muted">存放位置</text><text>{{item.locPath}}</text></view>
    <view class="kv"><text class="muted">归属方式</text><text>{{item.anchorText}}</text></view>
    <view class="kv" wx:if="{{item.homePath && item.homePath!==item.locPath}}"><text class="muted">常驻位置</text><text>{{item.homePath}}</text></view>
    <view class="kv" wx:if="{{item.borrowTo}}"><text class="muted">借出对象</text><text>{{item.borrowTo}}</text></view>
    <view class="kv" wx:if="{{item.dueDate}}"><text class="muted">预计归还</text><text>{{item.dueDate}}</text></view>
    <view class="kv" wx:if="{{item.disposalText}}"><text class="muted">处置类型</text><text>{{item.disposalText}}</text></view>
    <view class="kv" wx:if="{{item.photo}}"><text class="muted">照片</text><image class="thumb" src="{{item.photo}}" mode="aspectFill" bindtap="previewPhoto"></image></view>
    <view class="kv" wx:if="{{item.note}}"><text class="muted">备注</text><text class="grow">{{item.note}}</text></view>
  </view>

  <view class="card" wx:if="{{item.trackingMode!=='location' && inv}}">
    <view class="card-t">库存</view>
    <view class="row between">
      <view>
        <view class="strong" style="font-size:44rpx;color:{{inv.low?'#BE5F44':'#9C6B3F'}}">{{inv.balance}} {{inv.unit}}</view>
        <view class="small muted">最低阈值 {{inv.threshold}} {{inv.unit}}</view>
      </view>
      <text class="tag {{inv.low?'red':'green'}}" wx:if="{{inv.threshold>0}}">{{inv.low?'低库存':'正常'}}</text>
    </view>
    <view class="row" style="margin-top:16rpx" wx:if="{{item.mgmt==='active'}}">
      <button class="btn sm primary" bindtap="goInventory">入库/消耗/调整</button>
      <button class="btn sm" bindtap="goTx">查看交易流水</button>
    </view>
    <view class="row" style="margin-top:16rpx" wx:else>
      <button class="btn sm" bindtap="goTx">交易记录（只读）</button>
    </view>
  </view>

  <!-- 操作：对齐 demo pItemDetail 的竖列 .ops（图标 + 文字 + 箭头） -->
  <view class="card">
    <view class="card-t">操作</view>
    <view class="ops">
      <block wx:if="{{item.mgmt==='active'}}">
        <view class="op" bindtap="editItem"><text class="oi">✎</text>编辑档案<text class="chev">›</text></view>
        <view class="op" bindtap="moveItem"><text class="oi">✥</text>移动物品<text class="chev">›</text></view>
        <view class="op" wx:if="{{item.trackingMode!=='location' && inv}}" bindtap="goInventory"><text class="oi">▣</text>记一笔库存<text class="chev">›</text></view>
        <view class="op" bindtap="goHistory"><text class="oi">◷</text>位置历史<text class="chev">›</text></view>
        <view class="op danger" bindtap="endManage"><text class="oi">⚠</text>结束管理<text class="chev">›</text></view>
      </block>
      <block wx:else>
        <view class="op" bindtap="goHistory"><text class="oi">◷</text>位置历史<text class="chev">›</text></view>
        <view class="op" bindtap="restore"><text class="oi">↺</text>恢复日常管理<text class="chev">›</text></view>
      </block>
    </view>
    <view class="small muted" wx:if="{{item.mgmt==='ended'}}" style="margin-top:12rpx">已结束管理物品默认只读：可查看档案与历史，不可移动或进行库存交易。</view>
  </view>

  <button class="btn primary block" style="margin-top:20rpx" bindtap="goBackList">返回物品列表</button>
</view>

<view class="page" wx:else>
  <view class="state">
    <text class="state-icon">📦</text>
    <text class="state-title">未找到该物品</text>
    <text class="state-desc">档案可能已被清空或链接已失效，请返回物品列表查看。</text>
    <button class="btn primary" style="margin-top:32rpx" bindtap="goBackList">返回物品列表</button>
  </view>
</view>
