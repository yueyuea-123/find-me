<view class="page room-page">
  <!-- 截图1：副标题「我的家 · 共 N 个房间」；导航栏标题已是「房间」 -->
  <view class="room-subtitle">{{spaceName}} · 共 {{rooms.length}} 个房间</view>

  <!-- 截图1：房间卡片 = 图标 + 名称 + 尺寸·件数 + 场景模板/用户确认事实标签 + 右箭头，整卡进入三维房间页 -->
  <view class="card room-card" wx:for="{{rooms}}" wx:key="id" bindtap="enterRoom" data-id="{{item.id}}">
    <view class="row">
      <view class="room-icon">⌗</view>
      <view class="grow" style="margin-left:24rpx">
        <view class="card-t">{{item.name}}</view>
        <view class="card-s">{{item.dimText}} · {{item.furnitureCount}} 件家具</view>
        <view class="row wrap" style="margin-top:14rpx">
          <text class="tag gray">{{item.templateText}}</text>
          <text class="tag green">● 用户确认事实</text>
        </view>
      </view>
      <text class="muted">▸</text>
    </view>
  </view>

  <view class="note-inline" wx:if="{{rooms.length>0}}">房间可先以基础信息存在；三维不是业务数据可用的前提，WebGL 失败可切列表管理。</view>

  <view class="state" wx:if="{{rooms.length===0}}">
    <text class="state-icon">⌂</text>
    <text class="state-title">还没有房间，先建一个吧</text>
    <text class="state-desc" wx:if="{{hasSpace}}">新建房间后可添加家具与收纳位置</text>
    <text class="state-desc" wx:else>还没有空间，点击下方「＋ 新建房间」将自动创建默认空间</text>
  </view>

  <!-- 截图1：底部固定操作条「空间列表 / ＋ 新建房间」 -->
  <view class="room-cta">
    <button class="btn" bindtap="goSpaces">空间列表</button>
    <button class="btn primary" bindtap="openCreate">＋ 新建房间</button>
  </view>

  <view class="mask" wx:if="{{showEditor}}" bindtap="closeEditor"></view>
  <view class="sheet" wx:if="{{showEditor}}">
    <text class="sheet-title">{{editing?'编辑房间':'新建房间'}}</text>
    <view class="small muted" wx:if="{{!editing}}" style="margin:-12rpx 0 24rpx">填写宽 / 深 / 高作为布局输入，不承诺测量精度</view>
    <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
    <view class="field">
      <text class="label">房间名称 <text class="req">*</text></text>
      <input class="input" placeholder="例如：主卧 / 客厅" value="{{formName}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">尺寸参照（可选，单位米；留空按 4×4×2.8m）</text>
      <view class="row">
        <input class="input grow" style="margin-right:12rpx" type="number" placeholder="宽" value="{{formW}}" bindinput="onW" />
        <input class="input grow" style="margin-right:12rpx" type="number" placeholder="深" value="{{formD}}" bindinput="onD" />
        <input class="input grow" type="number" placeholder="高" value="{{formH}}" bindinput="onH" />
      </view>
    </view>
    <view class="sheet-actions">
      <button class="btn ghost" bindtap="closeEditor">取消</button>
      <button class="btn primary" wx:if="{{editing}}" bindtap="save">保存</button>
      <block wx:else>
        <!-- 户型由房间拼凑：可选更多房间类型模板，选中后用「用此模板创建」；卧室也在此列 -->
        <view class="tpl-picker" wx:if="{{templates.length}}">
          <view class="tpl-hint">选择初始布置模板（可多选房间拼成户型；不选则空白）</view>
          <view class="tpl-grid">
            <view class="tpl-item {{startTemplate===item.key?'sel':''}}"
                  wx:for="{{templates}}" wx:key="key"
                  data-template="{{item.key}}" bindtap="setStart">
              <text class="tpl-name">{{item.name}}</text>
              <text class="tpl-count">{{item.count}} 件</text>
            </view>
          </view>
        </view>
        <button class="btn primary" data-template="" bindtap="createRoom">创建空白房间</button>
        <button class="btn" data-template="bedroom" bindtap="createRoom">用卧室模板</button>
        <button class="btn" wx:if="{{startTemplate}}" data-template="{{startTemplate}}" bindtap="createRoom">用「{{startTemplateName}}」模板创建</button>
      </block>
    </view>
  </view>
</view>
