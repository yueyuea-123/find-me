/* pages/room/room.wxss —— 对齐 demo pRoom 的房间列表卡片布局 */

/* 顶部副标题：我的家 · 共 N 个房间 */
.room-subtitle { font-size: 26rpx; color: #8B8E87; margin: 4rpx 0 20rpx; }

/* 房间卡片：整卡可点，左图标 + 名称 + 尺寸·件数 + 双标签 + 右箭头 */
.room-card { padding: 30rpx 32rpx; }
.room-card:active { opacity: 0.82; }

/* 房间卡片左侧图标块：对齐 demo 的 accent-soft 方块 + grid 图标 */
.room-icon {
  width: 80rpx; height: 80rpx; border-radius: 24rpx;
  background: #F0EFEB; color: #6F8966;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; flex-shrink: 0;
}

/* 房间页留底部操作条空间 */
.room-page { padding-bottom: 180rpx; }

/* 底部固定操作条：空间列表 / ＋ 新建房间 */
.room-cta {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex; gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #F7F5F1;
  border-top: 1rpx solid #ECE9E3;
}
.room-cta .btn {
  flex: 1; margin: 0; height: 88rpx; border-radius: 24rpx;
  border: 1rpx solid #ECE9E3; background: #fff;
}
.room-cta .btn.primary { background: #6F8966; color: #fff; border-color: #6F8966; }

/* 户型拼凑：房间类型模板选择器（阶段四） */
.tpl-picker { margin: 4rpx 0 20rpx; }
.tpl-hint { font-size: 24rpx; color: #8B8E87; margin-bottom: 14rpx; }
.tpl-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tpl-item {
  display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
  min-width: 150rpx; padding: 14rpx 20rpx;
  background: #fff; border: 1rpx solid #ECE9E3; border-radius: 18rpx;
}
.tpl-item.sel { border-color: #6F8966; background: #E8EEE3; }
.tpl-name { font-size: 28rpx; color: #252824; line-height: 1.4; }
.tpl-item.sel .tpl-name { color: #58734F; font-weight: 600; }
.tpl-count { font-size: 22rpx; color: #8B8E87; }
