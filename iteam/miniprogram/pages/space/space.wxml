<view class="page">
  <view class="card space-card {{item.id===activeId?'space-current':''}}" wx:for="{{spaces}}" wx:key="id">
    <view class="row between" bindtap="choose" data-id="{{item.id}}">
      <view class="icon-box space-icon">⌂</view>
      <view class="grow" style="margin-left:20rpx">
        <view class="card-t">{{item.name}} <text class="tag blue" wx:if="{{item.id===activeId}}">当前</text></view>
        <view class="card-s">{{item.roomCount}} 个房间 · 个人空间</view>
      </view>
      <text class="muted">▸</text>
    </view>
    <view class="divider"></view>
    <view class="row">
      <button class="btn sm" catchtap="rename" data-id="{{item.id}}" data-name="{{item.name}}">重命名</button>
      <button class="btn sm danger" catchtap="archive" data-id="{{item.id}}" data-name="{{item.name}}">归档</button>
    </view>
  </view>

  <view class="note-inline" wx:if="{{spaces.length>0}}">首版仅支持个人单用户，不支持家庭成员共享；可创建多个空间分别管理。</view>

  <view class="state" wx:if="{{spaces.length===0}}">
    <text class="state-icon">⌂</text>
    <text class="state-title">还没有空间</text>
    <text class="state-desc">创建一个空间，例如「我的家」，开始建立家庭物品档案</text>
  </view>

  <view class="fab" bindtap="openCreate">+</view>

  <view class="mask" wx:if="{{showEditor}}" bindtap="closeEditor"></view>
  <view class="sheet" wx:if="{{showEditor}}">
    <text class="sheet-title">{{editing?'编辑空间':'新建空间'}}</text>
    <view class="small muted" wx:if="{{!editing}}" style="margin:-12rpx 0 24rpx">支持多个空间，首版仅个人使用</view>
    <view class="form-error" wx:if="{{formError}}">{{formError}}</view>
    <view class="field">
      <text class="label">空间名称 <text class="req">*</text></text>
      <input class="input" placeholder="例如：我的家 / 父母家" value="{{formName}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="sheet-actions">
      <button class="btn ghost" bindtap="closeEditor">取消</button>
      <button class="btn primary" bindtap="save">{{editing?'保存':'创建'}}</button>
    </view>
  </view>
</view>
