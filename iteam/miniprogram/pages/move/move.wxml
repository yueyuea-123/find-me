<view class="page">
  <view class="card">
    <view class="card-t">移动物品</view>
    <view class="card-s">{{itemName}}</view>
    <view class="divider"></view>
    <view class="kv"><text class="muted">当前位置状态</text><text class="tag {{currentLocClass}}">{{currentLocText}}</text></view>
    <view class="kv"><text class="muted">当前存放位置</text><text>{{currentPath}}</text></view>
  </view>

  <view class="card">
    <view class="card-t">① 选择位置状态</view>
    <view class="chip-grid">
      <view class="chip {{statusKey===item.key?'on':''}}" wx:for="{{statusList}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseStatus">
        {{item.name}}
      </view>
    </view>
    <view class="hint-box" wx:if="{{statusKey==='out'||statusKey==='borrowed'}}">记录外出/借出后，物品不再显示为在某个家庭内位置。日常随带无需记录；返回时再更新即可。</view>
  </view>

  <view class="card" wx:if="{{statusKey==='at_home'}}">
    <view class="card-t">② 选择目标位置</view>
    <picker mode="selector" range="{{nodeOptions}}" range-key="label" value="{{nodeIndex}}" bindchange="onNode">
      <view class="picker">{{nodeOptions[nodeIndex].label}} ▾</view>
    </picker>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">备注（可选）</text>
      <input class="input" placeholder="例如：临时放到客厅" value="{{note}}" bindinput="onNote" />
    </view>
    <button class="btn primary block" bindtap="confirm">确认移动</button>
  </view>
</view>
