/* pages/move/move.wxss */
.chip-grid { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip { font-size: 26rpx; padding: 14rpx 26rpx; background: #F3EDE2; color: #6B5D4D; border-radius: 999rpx; margin: 0 14rpx 14rpx 0; }
.chip.on { background: #9C6B3F; color: #fff; }
.kv { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 27rpx; }
.hint-box { background: #F6EDDC; border-left: 6rpx solid #9C6B3F; color: #6B5D4D; font-size: 24rpx; padding: 16rpx 20rpx; border-radius: 8rpx; margin-top: 16rpx; line-height: 1.6; }
