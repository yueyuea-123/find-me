<view class="page">
  <view class="card">
    <view class="card-t">基础管理后台</view>
    <view class="small muted">仅排障所需最小能力：任务状态、错误日志、用户统计。默认不展示家庭照片内容。</view>
    <view class="seg" style="margin-top:16rpx">
      <button class="btn sm {{tab==='tasks'?'primary':''}}" data-tab="tasks" bindtap="switchTab">任务状态</button>
      <button class="btn sm {{tab==='logs'?'primary':''}}" data-tab="logs" bindtap="switchTab">错误日志</button>
      <button class="btn sm {{tab==='users'?'primary':''}}" data-tab="users" bindtap="switchTab">用户统计</button>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view class="card-t">共 {{stats.total||0}} 条</view>
      <text class="muted small" bindtap="load">刷新 ▸</text>
    </view>
    <view class="log-item" wx:for="{{list}}" wx:key="id">
      <view class="row between">
        <text class="strong">{{item.title}}</text>
        <text class="muted small">{{item.time}}</text>
      </view>
      <view class="muted small" wx:if="{{item.detail}}">{{item.detail}}</view>
    </view>
    <view class="empty-line" wx:if="{{!loading && list.length===0}}">暂无记录</view>
    <view class="empty-line" wx:if="{{loading}}">加载中…</view>
  </view>
</view>
