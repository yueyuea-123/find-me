/* pages/item-list/item-list.wxss */
.search-card { position: sticky; top: 0; z-index: 5; }
.filter-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.filter-pill { font-size: 24rpx; color: #6B5D4D; background: #F3EDE2; padding: 10rpx 18rpx; border-radius: 999rpx; margin: 0 12rpx 12rpx 0; }
.filter-pill.on { background: #EFE2D1; color: #9C6B3F; }
