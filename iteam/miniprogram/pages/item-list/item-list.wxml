<view class="page">
  <view class="card search-card">
    <input class="input" placeholder="搜索物品名称 / 分类" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
    <view class="search-count">{{count}} 件</view>
    <view class="quick-filters">
      <view class="filter-pill {{quickFilter===item.key?'on':''}}" wx:for="{{quickOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onQuickFilter">{{item.name}}</view>
    </view>
    <view class="filter-row">
      <picker mode="selector" range="{{statusOptions}}" range-key="name" value="{{stIndex}}" bindchange="onStatus">
        <view class="filter-pill">{{statusOptions[stIndex].name}} ▾</view>
      </picker>
      <picker mode="selector" range="{{catOptions}}" value="{{catIndex}}" bindchange="onCat">
        <view class="filter-pill">{{catOptions[catIndex]}} ▾</view>
      </picker>
      <picker mode="selector" range="{{locOptions}}" range-key="name" value="{{locIndex}}" bindchange="onLoc">
        <view class="filter-pill">{{locOptions[locIndex].name}} ▾</view>
      </picker>
      <view class="filter-pill {{includeEnded?'on':''}}" bindtap="toggleEnded">含已结束</view>
    </view>
    <view class="filter-row">
      <picker mode="selector" range="{{spaceOptions}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpace">
        <view class="filter-pill">{{spaceOptions[spaceIndex].name}} ▾</view>
      </picker>
      <picker mode="selector" range="{{roomOptions}}" range-key="name" value="{{roomIndex}}" bindchange="onRoom">
        <view class="filter-pill">{{roomOptions[roomIndex].name}} ▾</view>
      </picker>
      <picker mode="selector" range="{{nodeOptions}}" range-key="label" value="{{nodeIndex}}" bindchange="onNode">
        <view class="filter-pill">{{nodeOptions[nodeIndex].label}} ▾</view>
      </picker>
    </view>
  </view>

  <view class="card item-card" wx:for="{{items}}" wx:key="id" bindtap="openItem" data-id="{{item.id}}">
    <view class="row between">
      <view class="icon-box list-icon">▣</view>
      <view class="grow" style="margin-left:20rpx">
        <view class="card-t">{{item.name}} <text class="tag {{item.mgmtClass}}">{{item.mgmtText}}</text></view>
        <view class="small muted">{{item.locPath}}</view>
        <view class="small muted" style="margin-top:6rpx">{{item.catText}} · {{item.modeText}} · 完善度 {{item.completed}}%</view>
        <view class="small" style="margin-top:6rpx;color:#8A94A0" wx:if="{{item.disposalText}}">处置：{{item.disposalText}}</view>
      </view>
      <text class="tag {{item.locClass}}">{{item.locText}}</text>
      <text class="muted">▸</text>
    </view>
  </view>

  <view class="state" wx:if="{{!loading && items.length===0}}">
    <text class="state-icon">🔍</text>
    <text class="state-title">{{hasFilter?'没有匹配的物品':'还没有物品档案'}}</text>
    <text class="state-desc">{{hasFilter?'试试调整筛选条件':'点右下角 + 添加第一件物品，只填名称即可'}}</text>
  </view>

  <view class="fab" bindtap="addItem">+</view>
</view>
