<view class="page">
  <view class="hero">
    <view class="row between">
      <view>
        <text class="hero-label">当前空间</text>
        <view class="hero-name" bindtap="goSpaces">{{stats.spaceName || '未设置空间'}} <text class="arrow">▸</text></view>
      </view>
      <view class="hero-badge" bindtap="goSpaces">切换</view>
    </view>
    <view class="hero-stats">
      <view class="stat" bindtap="goRooms"><text class="stat-n">{{stats.roomCount}}</text><text class="stat-l">房间</text></view>
      <view class="stat" bindtap="goItems"><text class="stat-n">{{stats.itemCount}}</text><text class="stat-l">物品</text></view>
      <view class="stat" bindtap="goInventory"><text class="stat-n">{{stats.inventoryCount}}</text><text class="stat-l">库存</text></view>
      <view class="stat" bindtap="goAlerts"><text class="stat-n {{stats.lowCount>0?'warn':''}}">{{stats.lowCount}}</text><text class="stat-l">提醒</text></view>
    </view>
  </view>

  <view class="card" wx:if="{{alerts.length>0}}" bindtap="goAlerts">
    <view class="row between">
      <view class="card-t">库存提醒 · {{alerts.length}} 项</view>
      <text class="muted small">查看 ▸</text>
    </view>
    <view class="alert-line" wx:for="{{alerts}}" wx:key="id">
      <text class="grow">{{item.name}}</text>
      <text class="muted small">剩 {{item.balance}}{{item.unit}} / 阈值 {{item.threshold}}{{item.unit}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-t">快捷操作</view>
    <view class="quick-grid">
      <view class="quick" bindtap="goAddItem"><text class="q-icon">➕</text><text>添加物品</text></view>
      <view class="quick" bindtap="goAddRoom"><text class="q-icon">🏠</text><text>新建房间</text></view>
      <view class="quick" bindtap="goRooms"><text class="q-icon">🛏️</text><text>管理家具</text></view>
      <view class="quick" bindtap="goSearch"><text class="q-icon">🔍</text><text>查找物品</text></view>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view class="card-t">最近变动</view>
      <text class="muted small" bindtap="goItems">全部 ▸</text>
    </view>
    <view class="recent" wx:for="{{recent}}" wx:key="id" bindtap="goItemDetail" data-id="{{item.itemId}}">
      <view class="recent-dot"></view>
      <view class="grow">
        <view class="strong">{{item.name}}</view>
        <view class="muted small">{{item.desc}}</view>
      </view>
      <text class="muted tiny">{{item.time}}</text>
    </view>
    <view class="empty-line" wx:if="{{recent.length===0}}">还没有变动记录，先添加一件物品吧</view>
  </view>

  <view class="foot-note">候选预测与用户确认事实分开保存 · 数据仅存本机</view>
</view>
