<!-- pages/index/index.wxml —— 首页（视觉方案 A，对齐 demo 截图） -->
<view class="page home">
  <!-- 上午好 + 空间名 -->
  <view class="hero-mini">
    <view class="hm-greet">{{hourGreet}}，康女士</view>
    <view class="hm-space" bindtap="goSpaces">{{stats.spaceName || '我的家'}} <text class="hm-caret">▾</text></view>
    <view class="hm-avatar" bindtap="goAlerts">康</view>
  </view>

  <!-- 四项统计 -->
  <view class="card stat-card">
    <view class="stat-grid">
      <view class="stat" bindtap="goRooms"><text class="stat-n">{{stats.roomCount}}</text><text class="stat-l">房间</text></view>
      <view class="stat" bindtap="goItems"><text class="stat-n">{{stats.itemCount}}</text><text class="stat-l">物品</text></view>
      <view class="stat" bindtap="goInventory"><text class="stat-n">{{stats.inventoryCount}}</text><text class="stat-l">库存</text></view>
      <view class="stat" bindtap="goAlerts"><text class="stat-n alert-n">{{stats.lowCount}}</text><text class="stat-l">提醒</text></view>
    </view>
  </view>

  <!-- 户型总览 -->
  <view class="card fp-card">
    <view class="fp-header">
      <view class="fp-title">户型总览 <text class="fp-meta">{{overview.rooms.length}} 间 · 约 {{overview.area}} ㎡</text></view>
      <view class="fp-actions">
        <text wx:if="{{editing}}" class="fp-auto" bindtap="autoLayout">恢复自动排布</text>
        <text class="fp-edit {{editing?'fp-done':''}}" bindtap="toggleEdit">{{editing?'完成':'编辑布局'}}</text>
      </view>
    </view>
    <view class="fp-hint">{{editing?'编辑中：拖动房间移动、拖任意边/角把手调整宽高；越界自动钳制，重叠不可保存':'点击房间查看三维 · 可「编辑布局」调整房间排布'}}</view>
    <view class="floorplan {{editing?'fp-grid-on':''}}" wx:if="{{!noRooms}}" style="height:{{overview.rows*96}}rpx">
      <view
        wx:for="{{overview.rooms}}"
        wx:key="id"
        class="fp-room tone-{{item.tone}} {{editing?'fp-editing':''}} {{dragInvalid&&dragging?'fp-invalid':''}}"
        style="grid-column:{{item.floor.x}} / {{item.floor.x+item.floor.w}};grid-row:{{item.floor.y}} / {{item.floor.y+item.floor.h}}"
        bindtap="goRoom3d"
        data-id="{{item.id}}"
        bindtouchstart="onRoomTouchStart"
        bindtouchmove="onRoomTouchMove"
        bindtouchend="onRoomTouchEnd"
      >
        <view class="fp-hd"><text>{{item.name}}</text><text class="fp-size">{{item.width}}×{{item.depth}}m</text></view>
        <view class="fp-body">
          <view wx:for="{{item.furn}}" wx:for-item="f" wx:key="id" class="fp-furn"
            style="left:{{f.left}}%;top:{{f.top}}%;width:{{f.w}}%;height:{{f.h}}%">{{f.icon}}</view>
        </view>
        <view wx:if="{{item.itemCount>0}}" class="fp-badge">{{item.itemCount}}</view>
        <view wx:if="{{editing}}" wx:for="{{['nw','n','ne','e','se','s','sw','w']}}" wx:for-item="h" wx:key="*this"
          class="fp-handle fh-{{h}}" data-id="{{item.id}}" data-handle="{{h}}" catchtouchstart="onRoomTouchStart" catchtouchmove="onRoomTouchMove" catchtouchend="onRoomTouchEnd"></view>
      </view>
    </view>
    <view class="fp-empty" wx:if="{{noRooms}}">
      <view class="fpe-icon">▦</view>
      <view class="fpe-title">还没有房间</view>
      <view class="small muted">点上方「房间」或「编辑布局」创建第一个房间，再放入家具</view>
    </view>
    <view class="fp-legend" wx:if="{{!noRooms}}">
      <text class="lg-item"><text class="lg-f"></text>家具</text>
      <text class="lg-item"><text class="lg-i"></text>物品数</text>
      <text class="fp-tip">墙线为示意，不承诺测量精度</text>
    </view>
  </view>

  <!-- 库存提醒（对齐 demo .remind：整卡 alert-soft 背景） -->
  <view class="remind" wx:if="{{alerts.length>0}}" bindtap="goAlerts">
    <view class="ri-icon">🔔</view>
    <view class="ri-body">
      <view class="ri-title">{{alerts.length}} 项库存提醒</view>
      <view class="ri-desc">{{alerts[0].name}} 剩 {{alerts[0].balance}}{{alerts[0].unit}}<text wx:if="{{alerts.length>1}}"> 等</text></view>
    </view>
    <view class="ri-go">查看</view>
  </view>

  <!-- 快捷操作 -->
  <view class="card quick-card">
    <view class="quick-grid">
      <view class="quick" bindtap="goRooms"><view class="q-icon">▦</view><text>房间</text></view>
      <view class="quick" bindtap="goAddItem"><view class="q-icon">＋</view><text>加物品</text></view>
      <view class="quick" bindtap="go3d"><view class="q-icon">◈</view><text>三维</text></view>
      <view class="quick" bindtap="goInventory"><view class="q-icon">☰</view><text>库存</text></view>
    </view>
  </view>

  <!-- 最近变动 -->
  <view class="card recent-card">
    <view class="recent-head">
      <view class="card-t">最近变动</view>
      <text class="muted small" bindtap="goItems">全部 ▸</text>
    </view>
    <view class="recent" wx:for="{{recent}}" wx:key="id" bindtap="goItemDetail" data-id="{{item.itemId}}">
      <view class="recent-dot"></view>
      <view class="grow">
        <view class="strong">{{item.name}}</view>
        <view class="muted small">{{item.desc}}</view>
      </view>
      <text class="muted tiny">{{item.time}}</text>
    </view>
    <view class="empty-line" wx:if="{{recent.length===0}}">暂无变动，去建一份档案吧</view>
  </view>

  <view class="foot-note">候选预测与用户确认事实分开保存 · 数据仅存本机</view>
</view>
