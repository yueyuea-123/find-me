/* pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #2b7a9b, #2b5f75);
  border-radius: 24rpx; padding: 36rpx 32rpx 28rpx; color: #fff;
  margin-bottom: 24rpx; box-shadow: 0 10rpx 30rpx rgba(43, 95, 117, 0.25);
}
.hero-label { font-size: 24rpx; opacity: 0.75; }
.hero-name { font-size: 40rpx; font-weight: 600; margin-top: 6rpx; }
.arrow { font-size: 28rpx; opacity: 0.8; }
.hero-badge { font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,0.2); }
.hero-stats { display: flex; margin-top: 32rpx; }
.stat { flex: 1; text-align: center; }
.stat-n { display: block; font-size: 40rpx; font-weight: 600; }
.stat-n.warn { color: #ffd06b; }
.stat-l { display: block; font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }
.alert-line { display: flex; justify-content: space-between; padding: 12rpx 0; border-top: 1rpx solid #eef1f4; font-size: 26rpx; }
.quick-grid { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.quick { width: 25%; text-align: center; font-size: 24rpx; color: #53646f; padding: 12rpx 0; }
.q-icon { display: block; font-size: 48rpx; margin-bottom: 8rpx; }
.recent { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #eef1f4; }
.recent:last-child { border-bottom: none; }
.recent-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #2b7a9b; margin-right: 18rpx; flex-shrink: 0; }
.empty-line { text-align: center; color: #8a94a0; font-size: 26rpx; padding: 40rpx 0; }
.foot-note { text-align: center; color: #b0b8c0; font-size: 22rpx; margin-top: 40rpx; }
