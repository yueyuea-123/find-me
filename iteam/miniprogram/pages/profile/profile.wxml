<view class="page">
  <!-- 对齐 demo pProfile：accent-soft tint 头像 + 康女士 + 单用户说明 + chips -->
  <view class="card">
    <view class="row">
      <view class="avatar">康</view>
      <view class="grow" style="margin-left:24rpx">
        <view class="card-t" style="font-size:34rpx">康女士</view>
        <view class="small muted">个人单用户 · 本地演示模式</view>
      </view>
    </view>
    <view class="chips4" style="margin-top:20rpx">
      <text class="tag green">● 本地可用</text>
      <text class="tag">数据仅存本机，不上传云端</text>
    </view>
  </view>

  <view class="card">
    <view class="card-t">数据管理</view>
    <view class="menu" bindtap="goBackup"><text>本地备份与恢复</text><text class="muted">{{backupCount}} 份 ▸</text></view>
    <view class="menu" bindtap="resetDemo"><text>重置演示数据</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="clearData"><text>清空本机数据</text><text class="muted">▸</text></view>
  </view>

  <view class="card">
    <view class="card-t">功能入口</view>
    <view class="menu" bindtap="goSpaces"><text>空间与房间</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goHistory"><text>全部位置历史</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goAlerts"><text>提醒中心</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goEnded"><text>已结束管理物品</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goPrivacy"><text>隐私与数据说明</text><text class="muted">▸</text></view>
  </view>

  <view class="card">
    <view class="card-t">关于</view>
    <view class="small muted">本应用为纯本地存储版本，所有数据仅保存在本机 `wx.Storage`，不上传任何服务器。清除小程序缓存会丢失数据，请定期使用「本地备份与恢复」导出备份。</view>
  </view>
</view>
