<view class="page">
  <view class="card profile-card">
    <view class="avatar">居</view>
    <view class="grow">
      <view class="strong" style="font-size:34rpx">个人空间</view>
      <view class="small muted">MVP 个人账户 · 数据云端隔离存储</view>
    </view>
  </view>

  <view class="card">
    <view class="card-t">账户与同步</view>
    <view class="kv"><text class="muted">登录状态</text><text class="strong">{{loggedIn?'已登录':'本地模式'}}</text></view>
    <view class="kv" wx:if="{{openidMask}}"><text class="muted">账户标识</text><text>{{openidMask}}</text></view>
    <view class="kv"><text class="muted">同步状态</text><text class="strong {{dirty?'warn':''}}">{{syncText}}</text></view>
    <view class="row wrap" style="margin-top:16rpx">
      <button class="btn sm primary" bindtap="syncNow">立即同步</button>
    </view>
    <view class="small muted" style="margin-top:12rpx">云端不可用时数据仍保存在本机，恢复后可继续同步。</view>
  </view>

  <view class="card">
    <view class="card-t">数据管理</view>
    <view class="menu" bindtap="goBackup"><text>备份与恢复</text><text class="muted">{{backupCount}} 份 ▸</text></view>
    <view class="menu" wx:if="{{isAdmin}}" bindtap="goAdmin"><text>管理后台</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="resetDemo"><text>载入演示数据</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="clearData"><text>清空本机数据</text><text class="muted">▸</text></view>
  </view>

  <view class="card">
    <view class="card-t">功能入口</view>
    <view class="menu" bindtap="goSpaces"><text>空间管理</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goAlerts"><text>提醒中心</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goEnded"><text>已结束管理物品</text><text class="muted">▸</text></view>
    <view class="menu" bindtap="goPrivacy"><text>隐私与数据说明</text><text class="muted">▸</text></view>
  </view>

  <view class="card">
    <view class="card-t">关于</view>
    <view class="small muted">三维室内空间与家庭物品管理系统 · MVP<br/>版本 V1.1 · 依据 PRD V1.1 / 业务规则 V1.1</view>
  </view>
</view>
