<view class="page">
  <view class="card">
    <view class="card-t">提醒中心</view>
    <view class="card-s">低于阈值时开启一个提醒周期，同一周期只生成一条；补货后自动结束。</view>
    <view class="chip-grid" style="margin-top:16rpx">
      <view class="chip {{tabKey===item.key?'on':''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
    </view>
  </view>

  <view class="card alert-card" wx:for="{{alerts}}" wx:key="id">
    <view class="row">
      <view class="alert-icon">🔔</view>
      <view class="grow" style="margin-left:20rpx">
        <view class="card-t">{{item.name}}</view>
        <view class="small muted">当前 {{item.balance}} {{item.unit}} · 阈值 {{item.threshold}} · {{item.status==='ignored'?'已忽略':(item.status==='recovered'?'已恢复':'待处理')}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row wrap">
      <button class="btn sm primary" wx:if="{{item.status!=='recovered'}}" bindtap="goDetail" data-id="{{item.itemId}}">去处理</button>
      <button class="btn sm" wx:if="{{item.status==='pending'}}" bindtap="ignore" data-id="{{item.id}}">忽略本次</button>
    </view>
  </view>

  <view class="state" wx:if="{{alerts.length===0}}">
    <text class="state-icon">✓</text>
    <text class="state-title">暂无待处理提醒</text>
    <text class="state-desc">补货使余额高于阈值后，当前提醒周期自动结束并恢复。</text>
  </view>
</view>
