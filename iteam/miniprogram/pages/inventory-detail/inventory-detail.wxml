<view class="page">
  <view class="card">
    <view class="card-t">{{name}}</view>
    <view class="row between" style="margin-top:16rpx">
      <view>
        <view class="bigbal {{low?'warn':''}}">{{balance}} <text class="unit">{{unit}}</text></view>
        <view class="small muted">当前余额</view>
      </view>
      <text class="tag {{low?'red':'green'}}" wx:if="{{threshold>0}}">{{low?'低库存':'正常'}}</text>
    </view>
    <view class="progress"><view class="progress-bar {{low?'warn':''}}" style="width:{{progress}}%"></view></view>
    <view class="chip warn-chip" wx:if="{{low}}">达到最低库存，已生成提醒</view>
  </view>

  <view class="card">
    <view class="card-t">库存变更</view>
    <view class="field" style="margin-top:16rpx">
      <text class="label">数量与说明</text>
      <view class="row">
        <input class="input grow" style="margin-right:12rpx" type="digit" placeholder="数量" value="{{amount}}" bindinput="onAmount" />
        <input class="input grow" placeholder="说明（可选）" value="{{txNote}}" bindinput="onTxNote" />
      </view>
    </view>
    <view class="row wrap">
      <button class="btn sm primary" data-key="in" bindtap="quickTx">入库</button>
      <button class="btn sm" data-key="consume" bindtap="quickTx">消耗</button>
      <button class="btn sm" data-key="adjust" bindtap="quickTx">调整</button>
    </view>
    <view class="small muted" style="margin-top:12rpx">调整与消耗分开记录；超额消耗被拒绝，库存不会低于零。</view>
  </view>

  <view class="card">
    <view class="card-t">阈值设置</view>
    <view class="row">
      <input class="input grow" style="margin-right:12rpx" type="number" placeholder="最低库存" value="{{threshold}}" bindinput="onThreshold" />
      <picker class="grow" mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onUnit">
        <view class="picker">{{units[unitIndex]}} ▾</view>
      </picker>
    </view>
    <button class="btn sm" style="margin-top:16rpx" bindtap="saveSettings">保存设置</button>
  </view>

  <view class="card">
    <view class="card-t">交易记录</view>
    <view class="tx" wx:for="{{txs}}" wx:key="id">
      <view class="row between">
        <view>
          <text class="tag {{item.cls}}">{{item.typeText}}</text>
          <text class="small muted">{{item.note}}</text>
        </view>
        <view class="right">
          <view class="strong {{item.delta>0?'plus':'minus'}}">{{item.delta>0?'+':''}}{{item.delta}}</view>
          <view class="small muted">余额 {{item.after}}</view>
        </view>
      </view>
      <view class="tiny muted" style="margin-top:6rpx">{{item.time}}</view>
    </view>
    <view class="empty-line" wx:if="{{txs.length===0}}">暂无交易记录</view>
  </view>
</view>
