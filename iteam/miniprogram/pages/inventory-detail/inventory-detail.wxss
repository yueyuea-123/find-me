/* pages/inventory-detail/inventory-detail.wxss */
.bigbal { font-size: 64rpx; font-weight: 600; color: #9C6B3F; }
.bigbal.warn { color: #BE5F44; }
.unit { font-size: 26rpx; }
.chip-grid { display: flex; flex-wrap: wrap; }
.chip { font-size: 26rpx; padding: 12rpx 24rpx; background: #F3EDE2; color: #6B5D4D; border-radius: 999rpx; margin: 0 12rpx 12rpx 0; }
.chip.on { background: #9C6B3F; color: #fff; }
.tx { padding: 18rpx 0; border-bottom: 1rpx solid #E9E0D2; }
.right { text-align: right; }
.plus { color: #6E7F59; }
.minus { color: #BE5F44; }
.empty-line { text-align: center; color: #A29481; font-size: 26rpx; padding: 40rpx 0; }
.progress { height: 10rpx; border-radius: 999rpx; background: #F3EDE2; overflow: hidden; margin-top: 18rpx; }
.progress-bar { height: 100%; background: #9C6B3F; border-radius: 999rpx; }
.progress-bar.warn { background: #BE5F44; }
.warn-chip { display: inline-block; margin-top: 14rpx; font-size: 24rpx; color: #BE5F44; background: #F6E2D9; border-radius: 999rpx; padding: 8rpx 18rpx; }
