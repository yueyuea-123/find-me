<view class="page">
  <view class="card">
    <view class="card-t">数据备份</view>
    <view class="small muted" style="line-height:1.7;margin-bottom:16rpx">备份保存当前云端全部空间、房间、家具、物品、库存与历史数据。恢复前系统会自动创建一份当前快照，可回滚。</view>
    <button class="btn primary" bindtap="createBackup">创建备份</button>
  </view>

  <view class="card">
    <view class="row between">
      <view class="card-t">备份记录</view>
      <text class="muted small" bindtap="load">刷新 ▸</text>
    </view>
    <view class="bk-item" wx:for="{{list}}" wx:key="id">
      <view class="row between">
        <view class="grow">
          <view class="strong">{{item.note || (item.type==='auto'?'自动备份':'手动备份')}}</view>
          <view class="muted small">{{item.time}} · {{item.recordCount}} 条记录</view>
        </view>
        <button class="btn sm" data-id="{{item.id}}" bindtap="restore">恢复</button>
      </view>
    </view>
    <view class="empty-line" wx:if="{{!loading && list.length===0}}">还没有备份记录</view>
    <view class="empty-line" wx:if="{{loading}}">加载中…</view>
  </view>

  <view class="foot-note">备份数据仅存于本人私有云空间 · 恢复操作会记录审计日志</view>
</view>
