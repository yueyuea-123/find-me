/* pages/room3d/room3d.wxss —— 模式1交互优化：
   房间头 → segbar → 三维视图窗口（红框，选中浮标）→ 工具条 → 家具卡（编辑小步操作）→ 横向模型库
   真 3D canvas 内嵌在窗口内；WebGL 失败或列表模式整页降级 */

.room3d-page { padding-bottom: 48rpx; }

/* 房间头 */
.room-head { margin: 4rpx 0 16rpx; }
.room-menu { font-size: 52rpx; color: #9C6B3F; padding: 0 8rpx; line-height: 1; }

/* 顶部模式胶囊：浏览 / 编辑 / 收纳 */
.segbar {
  display: inline-flex; align-items: center;
  background: #F3EDE2; border-radius: 999rpx; padding: 6rpx;
  margin: 0 0 20rpx;
}
.segbar .s {
  font-size: 26rpx; color: #6B5D4D; padding: 12rpx 34rpx;
  border-radius: 999rpx;
}
.segbar .s.on { background: #9C6B3F; color: #fff; }

/* 三维视图窗口（截图红框）：固定高度容器，canvas 填满 */
.view3d {
  position: relative; width: 100%; height: 520rpx;
  border-radius: 32rpx; overflow: hidden;
  background: linear-gradient(180deg, #F7F1E6 0%, #F0E7D8 100%);
  box-shadow: 0 6rpx 22rpx rgba(92, 68, 40, 0.10);
}
.glcanvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.view3d-badge {
  position: absolute; left: 20rpx; top: 18rpx; z-index: 2;
  background: rgba(255,255,255,0.9); color: #9C6B3F;
  border: 1rpx solid #E9E0D2; border-radius: 999rpx;
  padding: 6rpx 18rpx; font-size: 22rpx; pointer-events: none;
}
.canvas-hint {
  position: absolute; left: 20rpx; right: 20rpx; bottom: 18rpx;
  text-align: center; font-size: 22rpx; color: #8A7F71;
  pointer-events: none;
}
.view3d-empty {
  position: absolute; left: 0; right: 0; top: 50%; margin-top: -28rpx;
  text-align: center; font-size: 26rpx; color: #A29481; pointer-events: none;
}

/* 窗口下方工具条 */
.viewtools { display: flex; align-items: center; margin: 20rpx 0; }
.seg { display: flex; background: #F3EDE2; border-radius: 14rpx; padding: 4rpx; }
.seg-i { color: #6B5D4D; font-size: 24rpx; padding: 10rpx 18rpx; border-radius: 10rpx; }
.viewtools .btn.sm { margin: 0 0 0 12rpx; }

/* 选中家具卡片 */
.selcard { margin-top: 4rpx; }
.selname { font-size: 30rpx; }
.field-row { display: flex; margin-top: 20rpx; }
.field-cell {
  flex: 1; min-width: 0; margin-right: 12rpx; padding: 14rpx 16rpx;
  background: #F3EDE2; border-radius: 16rpx;
}
.field-cell:last-child { margin-right: 0; }
.fl { font-size: 22rpx; color: #A29481; margin-bottom: 6rpx; }
.fv { font-size: 24rpx; color: #3B3229; font-weight: 600; }
.fv-sm { font-size: 21rpx; }
.bindbox {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 18rpx; padding: 18rpx 20rpx;
  background: #E9EEE0; border-radius: 20rpx;
}
.bindbox .bi { font-size: 34rpx; color: #6E7F59; }

/* 编辑模式操作区：仅保留资料/添加物品/删除三个按钮 + 手势说明 */
.ops-edit { margin-top: 16rpx; }

/* 家具模型库：单行横向滚动 */
.libcard { margin-top: 20rpx; }
.libscroll { width: 100%; white-space: nowrap; }
.librow { display: inline-flex; }
.libitem { width: 140rpx; box-sizing: border-box; padding: 12rpx 8rpx 12rpx 0; text-align: center; }
.libico {
  width: 96rpx; height: 96rpx; line-height: 96rpx; margin: 0 auto;
  border-radius: 22rpx; background: #F6EDDC; font-size: 46rpx;
}
.libname { font-size: 22rpx; color: #6B5D4D; margin-top: 8rpx; }

/* 整页降级 */
.degrade-page .degrade-tip { padding: 16rpx 8rpx 8rpx; }
.degrade-page .room-icon { font-size: 38rpx; }
.degrade-page .room-cta { margin-top: 24rpx; }
