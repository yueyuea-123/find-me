<view class="page room3d-page">
  <!-- 顶部导航（高保真 02-客厅空间）：返回 / 房间名居中 / 右侧胶囊占位 -->
  <view class="hifi-nav">
    <text class="hifi-back" bindtap="onBack">‹</text>
    <text class="hifi-title">{{roomName}}</text>
    <view class="hifi-capsule" bindtap="roomMenu"><text>·</text><text>·</text><text>·</text><text class="hifi-dot">◉</text></view>
  </view>

  <!-- 从已有物品中选择并绑定到当前家具：独立整页，确保打开即见（规范 §5.2） -->
  <block wx:if="{{showBindPicker}}">
    <view class="degrade-page">
      <view class="degrade-tip">
        <view class="strong">绑定到「{{bindTargetName}}」</view>
        <view class="small muted">点选物品即建立/修改存放位置；已在此处的再次点选不会重复记录。</view>
      </view>
      <view class="card" wx:for="{{bindableItems}}" wx:key="id" data-id="{{item.id}}" bindtap="bindExistingItem">
        <view class="row between">
          <view class="grow">
            <view class="strong">{{item.name}} <text class="tag green" wx:if="{{item.here}}">已在此处</text></view>
            <view class="small muted">{{item.locText}}</view>
          </view>
          <text class="muted">▸</text>
        </view>
      </view>
      <view class="state" wx:if="{{bindableItems.length===0}}">
        <text class="state-title">还没有物品档案</text>
        <text class="state-desc">可先「新建物品」再返回绑定</text>
      </view>
      <view class="row" style="margin-top:24rpx">
        <button class="btn primary" bindtap="closeBindPicker">完成</button>
        <button class="btn" bindtap="addItemFromPicker">＋ 新建物品</button>
      </view>
    </view>
  </block>

  <!-- ============ 物品视图（V1.3 §8）：高保真 06-我的物品 双列卡片 ============ -->
  <block wx:elif="{{viewTab==='item'}}">
    <view class="hifi-itemview">
      <!-- 物品视图操作条：返回三维房间 / 添加家具（原死胡同，用户反馈无返回与新增入口） -->
      <view class="hifi-itemops">
        <view class="hifi-op" bindtap="backToRoom">‹ 返回房间</view>
        <view class="hifi-op primary" bindtap="addFurnitureFromItemView">＋ 添加家具</view>
      </view>
      <view class="hifi-search">⌕&nbsp; {{roomName}}物品 · {{spaceItems.length}} 件</view>
      <view class="hifi-grid">
        <view class="hifi-itemcard" wx:for="{{spaceItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openSpaceItem">
          <image class="hifi-itemimg" src="{{item.thumb}}" mode="aspectFill"/>
          <view class="hifi-itembody">
            <view class="hifi-itemname">{{item.name}}</view>
            <view class="hifi-itemqty">{{item.qty || '× 1'}}</view>
          </view>
        </view>
      </view>
      <view class="state" wx:if="{{spaceItems.length===0}}">
        <text class="state-title">{{roomName}}暂无物品</text>
        <text class="state-desc">可在家具上建档并指定收纳位置</text>
      </view>
    </view>
  </block>

  <!-- ============ 家具视图：高保真 02-客厅空间 沉浸式布局 ============ -->
  <block wx:elif="{{view==='3d' && !glError}}">
    <view class="hifi-stage">
      <canvas type="webgl" id="gl" class="glcanvas"
        catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
      <!-- 数量角标：浮在对应家具模型顶部，只提示“内有 N 件”，点家具仍弹面板看物品 -->
      <cover-view class="furn-badge" wx:for="{{furnitureBadges}}" wx:key="id"
        style="left:{{item.x}}px;top:{{item.y}}px">内有 {{item.n}} 件</cover-view>
      <!-- 左上空间胶囊 -->
      <cover-view class="hifi-stage-tag">{{roomName}} · 3D</cover-view>
      <!-- 右侧悬浮相机键：视角预设循环 / 复位 / 适配（对齐高保真三枚悬浮键） -->
      <cover-view class="hifi-cam">
        <cover-view class="hifi-cam-btn hifi-cam-text" data-preset="{{cameraPreset==='isometric'?'top':'isometric'}}" bindtap="setPreset">{{cameraPreset==='isometric'?'3D':'俯视'}}</cover-view>
        <cover-view class="hifi-cam-btn" bindtap="resetView">◎</cover-view>
        <cover-view class="hifi-cam-btn" bindtap="fitView">⛶</cover-view>
      </cover-view>
      <!-- 状态提示：选中浮标 / 手势说明 / 空房间 / dirty 标记 -->
      <cover-view class="view3d-badge" wx:if="{{selected && sceneMode!=='view'}}">已选：{{selected.name}}</cover-view>
      <cover-view class="canvas-hint" wx:if="{{!sheetOpen}}">{{hint}}</cover-view>
      <cover-view class="view3d-empty" wx:if="{{furniture.length===0}}">房间还是空的，点下方「添加家具」</cover-view>
      <cover-view class="hifi-dirty" wx:if="{{isDirty}}">● 待保存</cover-view>

      <!-- 底部抽屉：选中家具后展开，三维场景保持可见（V1.3 selected 态） -->
      <cover-view class="bsheet {{sheetOpen?'on':''}} {{sheetCollapsed?'collapsed':''}}" wx:if="{{selected && sceneMode==='selected'}}">
        <cover-view class="bsheet-bar" bindtap="toggleSheet">
          <cover-view class="bsheet-handle"></cover-view>
          <cover-view class="bsheet-title">{{selected.name}} · {{bindings.items.length}} 件物品</cover-view>
          <cover-view class="bsheet-toggle">{{sheetOpen?(sheetCollapsed?'展开':'收起'):'展开'}}</cover-view>
        </cover-view>
        <cover-view class="bsheet-close" bindtap="closeSheet" wx:if="{{sheetOpen}}">✕</cover-view>
        <block wx:if="{{sheetOpen && !sheetCollapsed}}">
          <cover-view class="bsheet-sub">收纳节点 · 点节点查看该处物品</cover-view>
          <cover-view class="bsheet-nodes">
            <cover-view class="bsheet-node {{activeNodeId===item.id?'on':''}}" wx:for="{{sheetNodes}}" wx:key="id"
              style="margin-left:{{item.depth*18}}rpx" data-id="{{item.id}}" bindtap="chooseNode">
              {{item.name}} · {{item.itemCount}}件
            </cover-view>
          </cover-view>
          <cover-view class="bsheet-sub">{{activeNodePath || '该家具暂无收纳节点'}} · 直接关联 {{nodeItems.length}}{{nodeItems.length===5?'+':''}} 件</cover-view>
          <cover-view class="bsheet-items" wx:if="{{nodeItems.length}}">
            <cover-view class="bsheet-item" wx:for="{{nodeItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openNodeItem">· {{item.name}}</cover-view>
          </cover-view>
          <cover-view class="bsheet-empty" wx:else>该位置暂无物品，可从下方直接建档</cover-view>
          <cover-view class="bsheet-actions">
            <cover-view class="bsheet-btn primary" bindtap="addItemAtActiveNode">＋ 添加物品</cover-view>
            <cover-view class="bsheet-btn" bindtap="goNodes">查看全部</cover-view>
            <cover-view class="bsheet-btn" bindtap="chooseAddItem">关联已有</cover-view>
            <cover-view class="bsheet-btn" bindtap="moreFurnitureOps">更多</cover-view>
          </cover-view>
        </block>
      </cover-view>
    </view>

    <!-- 底部悬浮坞（高保真）：家具 / 物品 分段 + 横向家具卡片 + 添加家具 -->
    <view class="hifi-dock">
      <view class="hifi-tabs">
        <view class="hifi-tab {{viewTab==='furniture'?'on':''}}" data-tab="furniture" bindtap="switchViewTab">家具</view>
        <view class="hifi-tab {{viewTab==='item'?'on':''}}" data-tab="item" bindtap="switchViewTab">物品（{{spaceItems.length}}）</view>
      </view>
      <scroll-view class="hifi-cards" scroll-x wx:if="{{furniture.length}}">
        <view class="hifi-card {{selected && selected.id===item.id?'on':''}}" wx:for="{{furniture}}" wx:for-index="idx" wx:key="id"
          data-index="{{idx}}" bindtap="selectIndex">
          <image wx:if="{{item.thumb}}" class="hifi-card-img" src="{{item.thumb}}" mode="aspectFill"/>
          <view wx:else class="hifi-card-icon {{selected && selected.id===item.id?'on':''}}">
            <text class="hifi-card-emoji">{{item.icon}}</text>
            <text class="hifi-card-model">{{item.model}}</text>
          </view>
          <view class="hifi-card-name">{{item.name}}</view>
          <view class="hifi-card-count" wx:if="{{item.bindCount>0}}">{{item.bindCount}} 件</view>
        </view>
      </scroll-view>
      <view class="hifi-emptycards" wx:else>房间还是空的，添加第一件家具开始布置</view>
      <view class="hifi-add" bindtap="toggleLib">添加家具</view>
    </view>

    <!-- 选中操作面板（V1.3 §4 管理/移动/旋转/尺寸；不依赖双击） -->
    <view class="selpanel" wx:if="{{selected && sceneMode==='selected' && !sheetOpen}}">
      <view class="selpanel-title">{{selected.name}} · {{selected.rot}}° · {{selected.sz}} cm</view>
      <view class="opgrid">
        <button class="btn sm primary" bindtap="openManage">管理</button>
        <button class="btn sm" bindtap="enterMove">移动</button>
        <button class="btn sm" bindtap="enterRotate">旋转</button>
        <button class="btn sm" bindtap="enterDimension">尺寸</button>
        <button class="btn sm" bindtap="changeModel">换模型</button>
      </view>
      <view class="edit-actions">
        <button class="btn sm" bindtap="undoScene">撤销</button>
        <button class="btn sm primary" bindtap="saveScene" disabled="{{sceneMode==='saving'}}">
          {{sceneMode==='saving'?'保存中…':'保存'}}
        </button>
      </view>
    </view>

    <!-- 移动模式（V1.3 §5.1）：方向按钮，每步 5cm -->
    <view class="editpanel" wx:if="{{sceneMode==='move'}}">
      <view class="edit-head">移动 · 每步 {{moveStepCm}} cm <text class="muted small">（地面平面，不抬起）</text></view>
      <view class="dpad">
        <button class="btn sm" data-dir="front" bindtap="moveStep">↑ 前</button>
        <view class="dpad-mid">
          <button class="btn sm" data-dir="left" bindtap="moveStep">← 左</button>
          <button class="btn sm" data-dir="right" bindtap="moveStep">右 →</button>
        </view>
        <button class="btn sm" data-dir="back" bindtap="moveStep">↓ 后</button>
      </view>
      <view class="edit-actions">
        <button class="btn sm" bindtap="cancelEdit">取消</button>
        <button class="btn sm primary" bindtap="finishEdit">完成</button>
      </view>
    </view>

    <!-- 旋转模式（V1.3 §5.2）：±15°，90° 快捷 -->
    <view class="editpanel" wx:if="{{sceneMode==='rotate'}}">
      <view class="edit-head">旋转 · 当前 {{curAngle}}° <text class="muted small">（绕垂直轴，每步 {{rotStepDeg}}°）</text></view>
      <view class="opgrid">
        <button class="btn sm" data-dir="-1" bindtap="rotateStep">↶ 15°</button>
        <button class="btn sm" data-dir="1" bindtap="rotateStep">15° ↷</button>
        <button class="btn sm" data-dir="-1" data-quick="1" bindtap="rotateStep">↶ 90°</button>
        <button class="btn sm" data-dir="1" data-quick="1" bindtap="rotateStep">90° ↷</button>
      </view>
      <view class="edit-actions">
        <button class="btn sm" bindtap="cancelEdit">取消</button>
        <button class="btn sm primary" bindtap="finishEdit">完成</button>
      </view>
    </view>

    <!-- 尺寸模式（V1.3 §5.3）：长宽高输入，单位 cm -->
    <view class="editpanel" wx:if="{{sceneMode==='dimension'}}">
      <view class="edit-head">尺寸 · 长 / 宽 / 高（cm）<text class="muted small">（底部中心锚点不变）</text></view>
      <view class="dimrow">
        <view class="dimcell"><view class="muted small">长</view><input class="diminput" type="number" data-field="l" value="{{dimL}}" bindinput="onDimInput" placeholder="cm"/></view>
        <view class="dimcell"><view class="muted small">宽</view><input class="diminput" type="number" data-field="w" value="{{dimW}}" bindinput="onDimInput" placeholder="cm"/></view>
        <view class="dimcell"><view class="muted small">高</view><input class="diminput" type="number" data-field="h" value="{{dimH}}" bindinput="onDimInput" placeholder="cm"/></view>
      </view>
      <view class="edit-actions">
        <button class="btn sm" bindtap="cancelEdit">取消</button>
        <button class="btn sm primary" bindtap="applyDimension">应用</button>
      </view>
    </view>

    <view class="state" wx:if="{{sceneMode==='saveError'}}">
      <text class="state-title">保存失败，草稿已保留</text>
      <text class="state-desc">可重试保存或继续编辑</text>
      <button class="btn sm primary" bindtap="saveScene">重试保存</button>
    </view>

    <!-- 家具模型库：点「添加家具」才展开，不常驻占据屏幕 -->
    <view class="card libcard" wx:if="{{showLib}}">
      <view class="card-t">家具模型库</view>
      <scroll-view class="libscroll" scroll-x>
        <view class="librow">
          <view class="libitem" wx:for="{{lib}}" wx:key="key" data-cat="{{item.key}}" bindtap="addFromLib">
            <view class="libico">{{item.icon}}</view>
            <view class="libname">{{item.key}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="small muted" style="margin-top:12rpx">点选即从库中添加到默认位置；选中后用「移动/旋转/尺寸」按钮调整。</view>
      <view class="row" style="margin-top:12rpx">
        <button class="btn sm" bindtap="addFurniture">建档家具</button>
        <button class="btn sm" bindtap="setView" data-v="list">列表模式</button>
        <button class="btn sm" bindtap="toggleLib">收起</button>
      </view>
    </view>
  </block>

  <!-- 整页降级：WebGL 不可用或手动切列表时，整页显示列表（场景隐藏） -->
  <block wx:else>
    <view class="degrade-page">
      <view class="degrade-tip">
        <view class="strong">家具列表（三维降级）</view>
        <view class="small muted">{{glError || '已切换到列表模式；数据管理不受影响'}}</view>
      </view>
      <view class="card" wx:for="{{furniture}}" wx:key="id" bindtap="selectFromList" data-id="{{item.id}}">
        <view class="row">
          <image class="degrade-thumb" src="{{item.thumb}}" mode="aspectFill"/>
          <view class="grow" style="margin-left:20rpx">
            <view class="card-t">{{item.name}}</view>
            <view class="card-s">{{item.bindCount}} 件关联物品 · 位置 {{item.px}} / {{item.pz}}</view>
          </view>
          <text class="muted">▸</text>
        </view>
      </view>
      <view class="state" wx:if="{{furniture.length===0}}">
        <text class="state-title">暂无家具</text>
        <text class="state-desc">点「添加家具」建档，或在三维视图中用模型库添加</text>
      </view>
      <view class="row" style="margin-top:24rpx">
        <button class="btn" wx:if="{{!glError}}" bindtap="setView" data-v="3d">返回三维</button>
        <button class="btn primary" bindtap="addFurniture">＋ 家具</button>
      </view>
    </view>
  </block>

  <!-- 兼容占位：保留 demo 原提示串（静态门禁对齐），实际提示由 {{hint}} 驱动 -->
  <view style="display:none">拖动摆放 · 长按删除 · 点击进入添加物品</view>
</view>
