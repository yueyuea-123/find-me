/* app.wxss —— 居所收纳全局样式（视觉方案 A「原木日常 / Oak & Linen」）
   与 demo / 高保真原型同源：暖米白底、白色大圆角卡、原木棕主色、苔绿正向、陶红异常 */
page {
  background: #FAF6EE;
  color: #3B3229;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.65;
}

button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

.page { padding: 28rpx 28rpx 60rpx; box-sizing: border-box; min-height: 100vh; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; }
.muted { color: #A29481; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; color: #3B3229; }
.center { text-align: center; }
.mt8 { margin-top: 16rpx; }
.mt16 { margin-top: 32rpx; }
.mt24 { margin-top: 48rpx; }

/* 卡片：白色大圆角 + 柔和暖影 */
.card {
  background: #fff; border-radius: 40rpx; padding: 32rpx;
  margin-bottom: 20rpx; box-shadow: 0 6rpx 22rpx rgba(92, 68, 40, 0.10);
}
.card-t { font-size: 30rpx; font-weight: 600; color: #3B3229; margin-bottom: 8rpx; }
.card-s { font-size: 24rpx; color: #A29481; }
.divider { height: 1rpx; background: #E9E0D2; margin: 20rpx 0; }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 18rpx 32rpx; border-radius: 24rpx; font-size: 28rpx;
  background: #F3EDE2; color: #6B5D4D; margin: 0 12rpx 12rpx 0;
}
.btn.primary { background: #9C6B3F; color: #fff; }
.btn.danger { background: #F6E2D9; color: #BE5F44; }
.btn.ghost { background: transparent; border: 1rpx solid #E9E0D2; color: #6B5D4D; }
.btn.block { width: 100%; }
.btn.sm { padding: 10rpx 22rpx; font-size: 24rpx; border-radius: 999rpx; margin: 0 8rpx 8rpx 0; }
.btn:active { opacity: 0.75; }

/* 徽标 */
.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; background: #F3EDE2; color: #6B5D4D; margin-right: 10rpx;
}
.tag.blue { background: #EFE2D1; color: #9C6B3F; }
.tag.green { background: #E9EEE0; color: #6E7F59; }
.tag.red { background: #F6E2D9; color: #BE5F44; }
.tag.orange { background: #F6E2D9; color: #BE5F44; }
.tag.gray { background: #F3EDE2; color: #A29481; }

/* 表单 */
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #6B5D4D; margin-bottom: 10rpx; }
.input, .textarea, .picker {
  width: 100%; box-sizing: border-box; background: #FAF6EE;
  border: 1rpx solid #E9E0D2; border-radius: 24rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #3B3229;
}
.textarea { min-height: 140rpx; }
.picker { display: flex; align-items: center; }
.req { color: #BE5F44; }
.form-error { background: #F6E2D9; color: #BE5F44; padding: 16rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; margin-bottom: 20rpx; }

/* 空态 / 加载 / 错误 */
.state { padding: 100rpx 40rpx; text-align: center; }
.state-icon { font-size: 90rpx; color: #C9B79B; display: block; margin-bottom: 20rpx; }
.state-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.state-desc { font-size: 26rpx; color: #A29481; display: block; line-height: 1.6; }

/* 列表项 */
.list-item { background: #fff; border-radius: 40rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.item-title { font-size: 30rpx; font-weight: 600; color: #3B3229; }
.item-meta { font-size: 24rpx; color: #A29481; margin-top: 8rpx; }

/* 悬浮添加 */
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx; width: 108rpx; height: 108rpx;
  border-radius: 50%; background: #9C6B3F; color: #fff; font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(156, 107, 63, 0.4); z-index: 20;
}

/* 底部弹层 */
.mask { position: fixed; inset: 0; background: rgba(59, 50, 41, 0.45); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 36rpx 32rpx 60rpx;
  max-height: 86vh; overflow-y: auto;
}
.sheet-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 28rpx; }
.sheet-actions { display: flex; margin-top: 20rpx; }
.sheet-actions .btn { flex: 1; margin: 0 8rpx; }

/* 进度条 */
.bar { height: 10rpx; background: #F3EDE2; border-radius: 999rpx; overflow: hidden; margin-top: 12rpx; }
.bar > view { height: 100%; background: #9C6B3F; }
