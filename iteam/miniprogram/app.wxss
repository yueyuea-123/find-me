/* app.wxss —— 居所收纳全局样式
   视觉基准：《家庭物品管理小程序_开发交付稿》高保真原型 + design-tokens.json V1.1
   鼠尾草绿主色 / 暖白底 / 白色大圆角卡 / 低饱和红异常。色值集中定义于 page，各页引用同一组值。 */
page {
  /* design-tokens.json V1.1：全局色板（rpx 逻辑宽度 750） */
  --bg: #F7F5F1;
  --surface: #FFFFFF;
  --surface-2: #F0EFEB;
  --text: #252824;
  --text-2: #8B8E87;
  --primary: #6F8966;
  --primary-dark: #58734F;
  --divider: #ECE9E3;
  --danger: #D65A50;
  --warning: #D89A3D;

  background: #F7F5F1;
  color: #252824;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.65;
}

button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

.page { padding: 28rpx 28rpx 60rpx; box-sizing: border-box; min-height: 100vh; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; }
.muted { color: #8B8E87; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; color: #252824; }
.center { text-align: center; }
.mt8 { margin-top: 16rpx; }
.mt16 { margin-top: 32rpx; }
.mt24 { margin-top: 48rpx; }

/* 卡片：白色大圆角 + 柔和暖影 */
.card {
  background: #fff; border-radius: 40rpx; padding: 32rpx;
  margin-bottom: 20rpx; box-shadow: 0 6rpx 22rpx rgba(92, 68, 40, 0.10);
}
.card-t { font-size: 30rpx; font-weight: 600; color: #252824; margin-bottom: 8rpx; }
.card-s { font-size: 24rpx; color: #8B8E87; }
.divider { height: 1rpx; background: #ECE9E3; margin: 20rpx 0; }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 18rpx 32rpx; border-radius: 24rpx; font-size: 28rpx;
  background: #F0EFEB; color: #8B8E87; margin: 0 12rpx 12rpx 0;
}
.btn.primary { background: #6F8966; color: #fff; }
.btn.danger { background: #F8E8E6; color: #D65A50; }
.btn.ghost { background: transparent; border: 1rpx solid #ECE9E3; color: #8B8E87; }
.btn.block { width: 100%; }
.btn.sm { padding: 10rpx 22rpx; font-size: 24rpx; border-radius: 999rpx; margin: 0 8rpx 8rpx 0; }
.btn:active { opacity: 0.75; }

/* 徽标 */
.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; background: #F0EFEB; color: #8B8E87; margin-right: 10rpx;
}
.tag.blue { background: #F0EFEB; color: #6F8966; }
.tag.green { background: #E8EEE3; color: #58734F; }
.tag.red { background: #F8E8E6; color: #D65A50; }
.tag.orange { background: #F8E8E6; color: #D65A50; }
.tag.gray { background: #F0EFEB; color: #8B8E87; }

/* 表单 */
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #8B8E87; margin-bottom: 10rpx; }
.input, .textarea, .picker {
  width: 100%; box-sizing: border-box; background: #F7F5F1;
  border: 1rpx solid #ECE9E3; border-radius: 24rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #252824;
}
.textarea { min-height: 140rpx; }
.picker { display: flex; align-items: center; }
.req { color: #D65A50; }
.form-error { background: #F8E8E6; color: #D65A50; padding: 16rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; margin-bottom: 20rpx; }

/* 空态 / 加载 / 错误 */
.state { padding: 100rpx 40rpx; text-align: center; }
.state-icon { font-size: 90rpx; color: #B7BDB0; display: block; margin-bottom: 20rpx; }
.state-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.state-desc { font-size: 26rpx; color: #8B8E87; display: block; line-height: 1.6; }

/* 选中态 / 提示条 / 内联说明（与 demo 的 chip.on / note-inline 一致） */
.chip.on, .chip.sel, .seg-i.on, .mode.on { background: #6F8966; color: #fff; }
/* note-inline 底色对齐 demo 的 --surface-2 (#F0EFEB) */
.note-inline { font-size: 24rpx; color: #8B8E87; background: #F0EFEB; border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; line-height: 1.7; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #6F8966; }

/* demo 对齐组件：竖列操作列表（pItemDetail / pProfile 的 .ops） */
.ops { display: flex; flex-direction: column; }
.op { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; font-size: 24rpx; }
.op + .op { border-top: 1rpx solid #ECE9E3; }
.op .oi { color: #8B8E87; margin-right: 6rpx; width: 36rpx; text-align: center; }
.op .chev { margin-left: auto; color: #8B8E87; font-size: 32rpx; }
.op.danger, .op.danger .oi { color: #D65A50; }
/* demo 对齐组件：方形图标块（accent-soft 底 + accent 图标，圆角 24rpx） */
.icon-box { background: #F0EFEB; color: #6F8966; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 24rpx; }

/* 加载骨架屏（弱网/云拉取时的占位反馈，避免空白闪屏） */
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
.skeleton {
  background: linear-gradient(90deg, #F0EFEB 25%, #EDE4D5 50%, #F0EFEB 75%);
  background-size: 200% 100%; animation: shimmer 1.4s ease-in-out infinite;
  border-radius: 16rpx;
}
.skeleton-line { height: 28rpx; margin-bottom: 16rpx; }
.skeleton-card { height: 180rpx; margin-bottom: 20rpx; }

/* 列表项 */
.list-item { background: #fff; border-radius: 40rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.item-title { font-size: 30rpx; font-weight: 600; color: #252824; }
.item-meta { font-size: 24rpx; color: #8B8E87; margin-top: 8rpx; }

/* 悬浮添加 */
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx; width: 108rpx; height: 108rpx;
  border-radius: 50%; background: #6F8966; color: #fff; font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(156, 107, 63, 0.4); z-index: 20;
}

/* 底部弹层 */
.mask { position: fixed; inset: 0; background: rgba(59, 50, 41, 0.45); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #fff; border-radius: 40rpx 40rpx 0 0; padding: 36rpx 32rpx 60rpx;
  max-height: 86vh; overflow-y: auto;
}
.sheet-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 28rpx; }
.sheet-actions { display: flex; margin-top: 20rpx; }
.sheet-actions .btn { flex: 1; margin: 0 8rpx; }

/* 进度条 */
.bar { height: 10rpx; background: #F0EFEB; border-radius: 999rpx; overflow: hidden; margin-top: 12rpx; }
.bar > view { height: 100%; background: #6F8966; }
