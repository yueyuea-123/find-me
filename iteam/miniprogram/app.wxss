/* app.wxss —— 居所收纳全局样式 */
page {
  background: #f5f6f8;
  color: #25313b;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

.page { padding: 24rpx 24rpx 60rpx; box-sizing: border-box; min-height: 100vh; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; }
.muted { color: #8a94a0; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; }
.center { text-align: center; }
.mt8 { margin-top: 16rpx; }
.mt16 { margin-top: 32rpx; }
.mt24 { margin-top: 48rpx; }

/* 卡片 */
.card {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 20rpx rgba(30, 50, 70, 0.05);
}
.card-t { font-size: 30rpx; font-weight: 600; color: #1d2b34; margin-bottom: 8rpx; }
.card-s { font-size: 24rpx; color: #8a94a0; }
.divider { height: 1rpx; background: #eef1f4; margin: 20rpx 0; }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 18rpx 32rpx; border-radius: 14rpx; font-size: 28rpx;
  background: #eef2f5; color: #33454f; margin: 0 12rpx 12rpx 0;
}
.btn.primary { background: #2b7a9b; color: #fff; }
.btn.danger { background: #fdecec; color: #c0392b; }
.btn.ghost { background: transparent; border: 1rpx solid #d8dfe5; color: #53646f; }
.btn.block { width: 100%; }
.btn.sm { padding: 10rpx 22rpx; font-size: 24rpx; border-radius: 10rpx; margin: 0 8rpx 8rpx 0; }
.btn:active { opacity: 0.75; }

/* 徽标 */
.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; background: #eef2f5; color: #5a6b76; margin-right: 10rpx;
}
.tag.blue { background: #e5f2f8; color: #2b7a9b; }
.tag.green { background: #e7f5ec; color: #27864d; }
.tag.red { background: #fdecec; color: #c0392b; }
.tag.orange { background: #fff2e2; color: #c47a1a; }
.tag.gray { background: #f0f1f3; color: #98a1aa; }

/* 表单 */
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #5b6b76; margin-bottom: 10rpx; }
.input, .textarea, .picker {
  width: 100%; box-sizing: border-box; background: #f6f8fa;
  border: 1rpx solid #e6ebef; border-radius: 12rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #25313b;
}
.textarea { min-height: 140rpx; }
.picker { display: flex; align-items: center; }
.req { color: #c0392b; }
.form-error { background: #fdecec; color: #c0392b; padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 24rpx; margin-bottom: 20rpx; }

/* 空态 / 加载 / 错误 */
.state { padding: 100rpx 40rpx; text-align: center; }
.state-icon { font-size: 90rpx; color: #c8d0d7; display: block; margin-bottom: 20rpx; }
.state-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.state-desc { font-size: 26rpx; color: #8a94a0; display: block; line-height: 1.6; }

/* 列表项 */
.list-item { background: #fff; border-radius: 18rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.item-title { font-size: 30rpx; font-weight: 600; color: #1d2b34; }
.item-meta { font-size: 24rpx; color: #8a94a0; margin-top: 8rpx; }

/* 悬浮添加 */
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx; width: 108rpx; height: 108rpx;
  border-radius: 50%; background: #2b7a9b; color: #fff; font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(43, 122, 155, 0.4); z-index: 20;
}

/* 底部弹层 */
.mask { position: fixed; inset: 0; background: rgba(20, 30, 40, 0.45); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 36rpx 32rpx 60rpx;
  max-height: 86vh; overflow-y: auto;
}
.sheet-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 28rpx; }
.sheet-actions { display: flex; margin-top: 20rpx; }
.sheet-actions .btn { flex: 1; margin: 0 8rpx; }

/* 进度条 */
.bar { height: 10rpx; background: #eef1f4; border-radius: 999rpx; overflow: hidden; margin-top: 12rpx; }
.bar > view { height: 100%; background: #2b7a9b; }
